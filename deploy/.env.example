# Copy this file to deploy/.env and replace every placeholder before starting
# production. This example is documentation only and is never loaded by the
# production compose file.
POSTGRES_DB=narravo
POSTGRES_USER=narravo
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://narravo:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/narravo

NEXTAUTH_URL=https://REPLACE_WITH_YOUR_DOMAIN
NEXTAUTH_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32
ADMIN_EMAILS=admin@example.com

# Optional OAuth credentials.
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_ID=
# GOOGLE_SECRET=

# Optional S3/R2 storage. Leave all of these unset to use the persistent local
# upload volume.
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
